# Application Configuration
APP_NAME=SunuFramework
APP_ENV=development
APP_URL=http://localhost/sunuframework2
APP_DEBUG=true
APP_KEY=

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sunuframework2
DB_USERNAME=root
DB_PASSWORD=

# Queue Configuration
QUEUE_CONNECTION=database

# Redis Configuration (for queue driver)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=0
REDIS_QUEUE_PREFIX=queue:

# OpenAI Configuration
OPENAI_API_KEY=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@sunuframework.com
MAIL_FROM_NAME="${APP_NAME}"

# SMS Configuration
SMS_DEFAULT_GATEWAY=
SMS_DEFAULT_SENDER_ID=

# Session Configuration
SESSION_LIFETIME=120
SESSION_DRIVER=file

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Security
CSRF_ENABLED=true
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=*
