# STAGING ENVIRONMENT
# Copy this to .env for staging/testing deployment

APP_NAME=SunuFramework
APP_ENV=staging
APP_URL=https://staging.yourproductiondomain.com
APP_DEBUG=true
APP_KEY=

# Database Configuration - Staging
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sunuframework2_staging
DB_USERNAME=staging_user
DB_PASSWORD=STAGING_PASSWORD_HERE

# Queue Configuration
QUEUE_CONNECTION=database

# Redis Configuration - Staging
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=0
REDIS_QUEUE_PREFIX=queue:staging:

# OpenAI Configuration
OPENAI_API_KEY=

# Mail Configuration - Staging (use Mailtrap or test SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=staging@sunuframework.com
MAIL_FROM_NAME="${APP_NAME} Staging"

# SMS Configuration - Staging (test mode)
SMS_DEFAULT_GATEWAY=test
SMS_DEFAULT_SENDER_ID=STAGING

# Session Configuration
SESSION_LIFETIME=120
SESSION_DRIVER=file

# Logging - Verbose for debugging
LOG_CHANNEL=daily
LOG_LEVEL=info

# Security - Production-like but with debug enabled
CSRF_ENABLED=true
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://staging.yourproductiondomain.com

# Staging Features
SHOW_ERROR_DETAILS=true
QUERY_LOG_ENABLED=true
FORCE_HTTPS=true
MAINTENANCE_MODE=false
