{
    "name": "sunu/framework2",
    "description": "A modular PHP framework",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\Core\\": "Core/",
            "Modules\\": "Modules/"
        }
    },
    "require": {
        "openai-php/client": "^0.18.0",
        "symfony/http-client": "^7.3",
        "nyholm/psr7": "^1.8",
        "predis/predis": "^3.3"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
