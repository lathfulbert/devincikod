# PRODUCTION ENVIRONMENT
# Copy this to .env for production deployment

APP_NAME=SunuFramework
APP_ENV=production
APP_URL=https://yourproductiondomain.com
APP_DEBUG=false
APP_KEY=

# Database Configuration - Production
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sunuframework2_prod
DB_USERNAME=prod_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# Queue Configuration
QUEUE_CONNECTION=redis

# Redis Configuration - Production
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_PASSWORD_HERE
REDIS_QUEUE_DB=0
REDIS_QUEUE_PREFIX=queue:prod:

# OpenAI Configuration
OPENAI_API_KEY=

# Mail Configuration - Production (use real SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourproductiondomain.com
MAIL_FROM_NAME="${APP_NAME}"

# SMS Configuration - Production
SMS_DEFAULT_GATEWAY=your_sms_provider
SMS_DEFAULT_SENDER_ID=YourBrand

# Session Configuration
SESSION_LIFETIME=120
SESSION_DRIVER=redis

# Logging - Less verbose in production
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Security - Strict in production
CSRF_ENABLED=true
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://yourproductiondomain.com

# Production Features
SHOW_ERROR_DETAILS=false
QUERY_LOG_ENABLED=false
FORCE_HTTPS=true
MAINTENANCE_MODE=false
