# DEVELOPMENT ENVIRONMENT
# Copy this to .env for local development

APP_NAME=SunuFramework
APP_ENV=development
APP_URL=http://localhost/sunuframework2
APP_DEBUG=true
APP_KEY=

# Database Configuration - Development
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sunuframework2_dev
DB_USERNAME=root
DB_PASSWORD=

# Queue Configuration
QUEUE_CONNECTION=database

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=0
REDIS_QUEUE_PREFIX=queue:dev:

# OpenAI Configuration
OPENAI_API_KEY=

# Mail Configuration - Development (use Mailtrap or similar)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=dev@sunuframework.com
MAIL_FROM_NAME="${APP_NAME} Dev"

# SMS Configuration - Development (mock mode)
SMS_DEFAULT_GATEWAY=mock
SMS_DEFAULT_SENDER_ID=DEV

# Session Configuration
SESSION_LIFETIME=120
SESSION_DRIVER=file

# Logging - Verbose in development
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Security - Relaxed in development
CSRF_ENABLED=true
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*

# Development Features
SHOW_ERROR_DETAILS=true
QUERY_LOG_ENABLED=true
